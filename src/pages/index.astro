---
import CanonicalPage from '../components/CanonicalPage.astro';
import { publicationEntry, isHistorical } from '../lib/publication';
import { renderEntry } from '../lib/content';
import { renderHomeStatus, renderHomeHeading, renderEditorialState, renderBeginnerDiagram } from '../lib/presentation';
import ReadingLayout from '../layouts/ReadingLayout.astro';
import { activeConfig } from '../lib/site-config';
import { withBase } from '../lib/urls';
import { requiresMathStyles } from '../lib/markdown';
const { corpus, entry } = publicationEntry('DOC-HOME');
const historical=isHistorical(entry);
const html = historical?'':await renderEntry(corpus,entry,activeConfig().basePath);
const status = historical?undefined:publicationEntry('DOC-STATUS').entry;
const statusHTML = status?renderHomeStatus(corpus,status,activeConfig().basePath):'';
const start = withBase('/start/', activeConfig().basePath);

---
{historical ? <CanonicalPage id={entry.id} /> : <ReadingLayout title={entry.title} description={entry.description} route="/" math={requiresMathStyles(html + statusHTML)}>
  <section class="hero shell" aria-labelledby="research-question">
    <div><p class="eyebrow">A question about organization</p>
      <h1 id="research-question" set:html={renderHomeHeading(entry.title)} />
      <p class="hero-lede">{entry.description}</p>
      <a class="button" href={start}>Start with the idea <span aria-hidden="true">→</span></a>
      <p class="reading-note">A short introduction · No technical background needed</p>
      <p class="reading-note" data-editorial-state={entry.id} set:html={renderEditorialState(corpus,entry)} />
    </div>
  </section>
  <section class="reading-section shell"><div class="margin-label"><span>01 / The idea</span><p>From something familiar<br />to a research question.</p></div><div class="prose"><div data-canonical-body={entry.id} set:html={html} /><Fragment set:html={renderBeginnerDiagram(entry.id)} /></div></section>
  <section class="pathways shell" aria-labelledby="explore-title">
    <div class="section-heading"><p class="eyebrow">Choose your depth</p><h2 id="explore-title">Follow the question.</h2></div>
    <div class="pathway-grid">
      <a class="pathway" href={withBase('/examples/string/',activeConfig().basePath)}><span class="pathway-number">01 / Constraints</span><h3>A string's possible motion <span aria-hidden="true">↗</span></h3><p>Fixed ends, physical conditions and the patterns they support.</p><span class="pathway-state">Explore the string</span></a>
      <a class="pathway" href={withBase('/examples/molecule/',activeConfig().basePath)}><span class="pathway-number">02 / A whole</span><h3>More than a bag of atoms <span aria-hidden="true">↗</span></h3><p>Connections constrain collective behaviour while the parts remain active.</p><span class="pathway-state">Explore the molecule</span></a>
      <a class="pathway" href={withBase('/examples/life-environment/',activeConfig().basePath)}><span class="pathway-number">03 / Possibilities</span><h3>Life changes conditions <span aria-hidden="true">↗</span></h3><p>An existing organization can change what becomes possible around it.</p><span class="pathway-state">Explore life and environment</span></a>
    </div>
    <p class="reading-note"><a href={withBase('/examples/',activeConfig().basePath)}>All six examples</a> · <a href={withBase('/concepts/',activeConfig().basePath)}>Explore the source meanings</a></p>
  </section>
  <section class="open-question shell"><p class="eyebrow">The work ahead</p><h2>A framework to investigate.</h2><div class="prose" data-source-projection={status!.id} set:html={statusHTML} /><p><a href={withBase(status!.route,activeConfig().basePath)}>Read current research status</a></p></section>
  <section class="shell edition-note"><p class="eyebrow">The current edition</p><p>Core definitions, source-reported evidence and open extensions remain distinct. <a href={withBase('/references/',activeConfig().basePath)}>Find the sources</a> and <a href={withBase('/research-status/',activeConfig().basePath)}>follow the current status</a>.</p><p class="reading-note">Public introduction: author approval pending.</p></section>
</ReadingLayout>}
