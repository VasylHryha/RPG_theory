---
import ReadingLayout from '../layouts/ReadingLayout.astro';
import { readingPages } from '../lib/contents';
import { publicationCredit, renderAbout } from '../lib/publication-policy';
import { activeConfig } from '../lib/site-config';
const html=renderAbout(publicationCredit(),activeConfig().basePath);
---
<ReadingLayout {...readingPages['/about/']} route="/about/">
  <article class="article shell"><h1>About RRG</h1><div class="prose" data-about set:html={html} /></article>
</ReadingLayout>
