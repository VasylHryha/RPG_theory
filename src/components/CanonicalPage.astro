---
import ReadingLayout from '../layouts/ReadingLayout.astro';
import RecordStatus from './RecordStatus.astro';
import { renderEntry } from '../lib/content';
import { activePublication, isHistorical } from '../lib/publication';
import { activeConfig } from '../lib/site-config';
import { renderRecordDetails, renderBeginnerDiagram } from '../lib/presentation';
import { requiresMathStyles } from '../lib/markdown';
const { id } = Astro.props as { id: string };
const { corpus,entries } = activePublication();
const entry = entries.find(e=>e.id===id);
if (!entry) throw new Error(`Entry not selected: ${id}`);
const html = await renderEntry(corpus,entry,activeConfig().basePath);
const details=renderRecordDetails(corpus,entry,activeConfig().basePath);
const diagram=isHistorical(entry)?'':renderBeginnerDiagram(entry.id);
const earlyDiagram=entry.id==='DOC-EXAMPLE-STRING';
---
<ReadingLayout title={entry.title} description={entry.description} route={entry.route} math={requiresMathStyles(html + details)}>
  <article class="article shell"><header><p class="eyebrow">{entry.id} · Revision {entry.revision}</p><h1>{entry.title}</h1><p class="article-lede">{entry.description}</p></header>
  <RecordStatus entry={entry} corpus={corpus} />
  {earlyDiagram && <Fragment set:html={diagram} />}
  <div class="prose" data-canonical-body={entry.id} set:html={html} />
  {!earlyDiagram && <Fragment set:html={diagram} />}
  <div data-record-details={entry.id} set:html={details} /></article>
</ReadingLayout>
