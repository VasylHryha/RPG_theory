---
import '../styles/global.css';
import { activeConfig, activeMode } from '../lib/site-config';
import { canonicalURL, withBase } from '../lib/urls';
import { renderNavigation, renderHeaderTools } from '../lib/presentation';
import { activePublication } from '../lib/publication';
import { renderFooter } from '../lib/publication-policy';
import { pageMetadata, metadataJSON } from '../lib/site-metadata';
import { renderBreadcrumb, renderPageTurn, renderRelated } from '../lib/contents';
// Use the stylesheet belonging to rehype-katex's lockfile-pinned renderer.
// The separately installed root KaTeX version emits different box markup.
import mathStylesheet from '../../node_modules/rehype-katex/node_modules/katex/dist/katex.min.css?url';
interface Props { title: string; description: string; route: string; math?: boolean }
const { title, description, route, math = false } = Astro.props;
const config = activeConfig();
const url = (path: string) => withBase(path, config.basePath);
const selected=activePublication();
const source = {...selected.admission,errorCode:null};
const breadcrumb=renderBreadcrumb(selected,route,config.basePath);
const related=breadcrumb?renderRelated(selected,route,config.basePath):'';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={activeMode()==='release' && selected.entries.some(e=>e.route===route && e.publicationState==='published')?'index, follow':'noindex, nofollow'} />
    <meta name="color-scheme" content="light dark" />
    <title>{title} · RRG</title>
    <link rel="canonical" href={canonicalURL(route, config)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL(route, config)} />
    <meta property="og:type" content={selected.entries.some(e=>e.route===route && e.kind==='article' && e.publicationState==='published')?'article':'website'} />
    <script is:inline type="application/ld+json" data-site-metadata set:html={metadataJSON(pageMetadata(title,description,route,config,selected.entries.find(e=>e.route===route)))} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    {math && <link rel="stylesheet" href={mathStylesheet} data-math-stylesheet />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {activeMode()!=='release' && <div class="preview-strip">Private {activeMode() === 'qualification' ? 'qualification' : 'preview'} <span>· {activeMode()==='qualification'?'Reviewed selection; deployment disabled':'Draft website explanations'}</span></div>}
    {selected.manifest.releaseId.endsWith('-first-test') && <div class="preview-strip" aria-label="Research edition">Author’s research draft <span>· Open to review and revision</span></div>}
    <header class="site-header shell">
      <a class="brand" href={url('/')} aria-label="RRG home"><span class="brand-mark" aria-hidden="true">↔</span> RRG</a>
      <nav aria-label="Main navigation" data-publication-navigation set:html={renderNavigation(selected,route,config.basePath)} />
      <nav aria-label="Contact and search" class="header-tools" data-header-tools set:html={renderHeaderTools(route,config.basePath)} />
    </header>
    <main id="main" tabindex="-1">
      {breadcrumb && <nav class="breadcrumb shell" aria-label="Breadcrumb" data-book-breadcrumb set:html={breadcrumb} />}
      <slot />
      {related && <aside class="related-readings shell" aria-label="Related readings" data-book-related set:html={related} />}
      {breadcrumb && route!=='/contents/' && <nav class="page-turn shell" aria-label="Page navigation" data-book-page-turn set:html={renderPageTurn(selected,route,config.basePath)} />}
    </main>
    <aside class="source-note shell" aria-label="Source availability">
      <details><summary>About the source documents</summary><p><strong>{source.bytesVerified ? 'Current sources available' : 'Current sources unavailable'}</strong></p><p>{source.bytesVerified ? `${source.files} supplied files checked against the recorded edition. ${source.currentSourceQualified ? 'Website explanations reviewed against the supplied documents.' : 'Website explanations are drafts.'}` : `Source intake requires attention (${source.errorCode}). No historical document is used as a current substitute.`}</p></details>
    </aside>
    <footer class="site-footer shell" data-publication-footer set:html={renderFooter(config.basePath)} />
  </body>
</html>
