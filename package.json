{
  "name": "unity-theory",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "check:sources": "tsx scripts/check-sources.ts",
    "test:content": "tsx --test tests/content/*.test.ts",
    "build": "tsx scripts/build.ts",
    "audit:output": "tsx scripts/audit-output.ts",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:ci": "tsx scripts/verify.ts --profile routine",
    "verify:push": "tsx scripts/verify.ts --profile push",
    "serve": "tsx scripts/serve.ts",
    "check:content": "tsx scripts/check-content.ts",
    "check:source-revision": "tsx scripts/check-source-revision.ts",
    "check:publication": "tsx scripts/check-publication.ts",
    "check:m6": "tsx scripts/check-m6-integration.ts",
    "verify:live": "tsx scripts/verify-live.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "astro": "7.3.5",
    "katex": "0.18.10",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "cheerio": "1.2.0",
    "lighthouse": "13.5.0",
    "pagefind": "1.5.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
