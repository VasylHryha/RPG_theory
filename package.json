{
  "name": "unity-theory",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "scripts": {
    "edition": "node --import tsx scripts/edition.ts",
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "check:sources": "node --import tsx scripts/check-sources.ts",
    "test:content": "node --import tsx --test --test-concurrency=1 tests/content/*.test.ts",
    "build": "node --import tsx scripts/build.ts",
    "audit:output": "node --import tsx scripts/audit-output.ts",
    "test:e2e": "node --import tsx scripts/test-e2e.ts",
    "verify": "node --import tsx scripts/verify.ts",
    "verify:ci": "node --import tsx scripts/verify.ts --profile routine",
    "verify:push": "node --import tsx scripts/verify.ts --profile push",
    "verify:full": "node --import tsx scripts/verify.ts --profile full",
    "verify:monthly": "node --import tsx scripts/verify.ts --profile full",
    "serve": "node --import tsx scripts/serve.ts",
    "check:content": "node --import tsx scripts/check-content.ts",
    "check:source-revision": "node --import tsx scripts/check-source-revision.ts",
    "check:publication": "node --import tsx scripts/check-publication.ts",
    "check:m6": "node --import tsx scripts/check-m6-integration.ts",
    "verify:live": "node --import tsx scripts/verify-live.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "astro": "7.3.5",
    "katex": "0.19.0",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "cheerio": "1.2.0",
    "lighthouse": "13.5.0",
    "pagefind": "1.5.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
